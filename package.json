{
  "name": "n8n-manager-mcp",
  "version": "0.1.15",
  "mcpName": "io.github.ellmos-ai/n8n-manager-mcp",
  "description": "MCP server for n8n workflow management -- view, create, sync, and manage n8n workflows via AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "n8n-manager-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "README_de.md",
    "CHANGELOG.md",
    "server.json",
    "glama.json",
    "smithery.yaml",
    "llms.txt",
    "SECURITY.md",
    "scripts/smoke-mcp.js"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "smoke": "node scripts/smoke-mcp.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "n8n",
    "workflow",
    "workflow-management",
    "n8n-workflows",
    "automation",
    "claude",
    "claude-code",
    "ai-automation",
    "ai-tools",
    "mcp-server"
  ],
  "author": "Lukas Geiger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellmos-ai/n8n-manager-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ellmos-ai/n8n-manager-mcp/issues"
  },
  "homepage": "https://github.com/ellmos-ai/n8n-manager-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "update-notifier": "^7.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "hono": "^4.13.0",
    "express-rate-limit": "^8.6.2",
    "nanoid": "^3.3.17",
    "fast-uri": "^3.1.5",
    "@hono/node-server": "^2.0.5",
    "ip-address": "^10.4.0",
    "qs": "^6.15.2",
    "vitest": "^3.2.6",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
